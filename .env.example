# Process-level config (read at startup, before the DB is open).
# Everything else (LLM/whisper/intervals) is configured at runtime via Settings.

# Where SQLite + audio files live.
HUSHPOD_DATA_DIR=./data
# HUSHPOD_DB_PATH=./data/hushpod.db

# HTTP bind.
PORT=3000
HOST=0.0.0.0

# Optional explicit binary paths (otherwise found on PATH).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
